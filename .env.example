# Copy to .env and fill in whatever you have. Nothing here is required to run
# the retrieval eval or the tests -- those work fully offline.

# Embeddings backend: "tfidf" (offline, default) or "sentence-transformers"
EMBEDDING_BACKEND=tfidf

# Reranker backend: "bm25" (offline, default), "cohere", "cross-encoder", or "none"
RERANK_BACKEND=bm25

# Vector store: "numpy" (offline, default) or "chroma"
VECTOR_STORE=numpy

# Only needed if you switch to the hosted backends above / run generation evals
COHERE_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
